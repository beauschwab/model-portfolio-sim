# Reference values; export these variables in your shell/process manager.
# Defaults need no environment file: SQLite and .data/workbench/artifacts.
WORKBENCH_ENV=development
WORKBENCH_EXECUTION=external
WORKBENCH_TENANT_ID=dev
WORKBENCH_WORKSPACE_ID=example
WORKBENCH_SEED_DEMO=1
# Explicit admission for <=60k positions / <=90m work units on /balance-stress/stream.
# Keep disabled until the deployment has been capacity-tested.
WORKBENCH_BALANCE_LARGE_BOOK=0
# Supported v1 scope only (docs/supported-scope.md). Set to 1 to admit experimental models.
WORKBENCH_EXPERIMENTAL_MODELS=0
WORKBENCH_WORKER_URL=http://127.0.0.1:8002
# DATABASE_URL=sqlite:///C:/absolute/path/workbench.db
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/workbench
# ARTIFACT_URL=s3://YOUR_BUCKET/workbench
# Optional read-only tape source allowlists (uploads need neither).
# WORKBENCH_TAPE_ROOT=C:/data/loan-tapes
# WORKBENCH_TAPE_S3_PREFIX=s3://YOUR_BUCKET/loan-tapes
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# WORKBENCH_API_TOKEN=SET_FROM_SECRET_MANAGER
# WORKBENCH_WORKER_TOKEN=SET_FROM_SECRET_MANAGER
# AWS_REGION=us-east-1
# WORKBENCH_SCRATCH_DIR=C:/short/path/workbench-scratch
# Optional named Iceberg catalog (install the iceberg extra).
# Calculations require Rust (0.29.4); build all native artifacts and restart workers.
# Python calculation is deprecated. Backend is a revisioned workspace setting,
# not an environment fallback. Historical Python settings must be changed to Rust.
# PYICEBERG_CATALOG__ANALYTICS__TYPE=rest
# PYICEBERG_CATALOG__ANALYTICS__URI=https://YOUR_CATALOG
# PYICEBERG_CATALOG__ANALYTICS__WAREHOUSE=YOUR_WAREHOUSE
# For local Windows SQL catalog examples:
# PYICEBERG_CATALOG__LOCAL__TYPE=sql
# PYICEBERG_CATALOG__LOCAL__URI=sqlite:///C:/short/path/catalog.db
# PYICEBERG_CATALOG__LOCAL__WAREHOUSE=file:///C:/short/path/warehouse
# PYICEBERG_CATALOG__LOCAL__PY_IO_IMPL=pyiceberg.io.fsspec.FsspecFileIO
# Rust workbench service (apps/api-rust; same database, objects and scope as above).
# PORTFOLIO_MODEL_LEDGER_EXE=C:/path/to/portfolio-model-ledger.exe
# WORKBENCH_NATIVE_BIND=127.0.0.1:8003
# WORKBENCH_ALLOWED_ORIGIN=https://workbench.example.internal
# WORKBENCH_NATIVE_DEADLINE_SECONDS=900
# Optional embedded Goose analyst pilot; see docs/embedded-analysts.md.
WORKBENCH_ANALYST_ENABLED=0
# WORKBENCH_ANALYST_SECRET=SET_FROM_SECRET_MANAGER_AT_LEAST_32_RANDOM_CHARACTERS
# WORKBENCH_GOOSE_EXECUTABLE=C:/absolute/path/to/goose.exe
# WORKBENCH_GOOSE_SHA256=SHA256_OF_THE_EXECUTABLE_NOT_THE_DOWNLOAD_ARCHIVE
# WORKBENCH_GOOSE_PROVIDER=openrouter
# WORKBENCH_GOOSE_MODEL=anthropic/claude-sonnet-5.5
# OPENROUTER_API_KEY=SET_FROM_SECRET_MANAGER
# OpenRouter's key is forwarded automatically; other providers require explicit keys.
# WORKBENCH_GOOSE_ENV_KEYS=OPENAI_API_KEY
# Local OpenRouter setup: bun run setup:analysts; edit ignored apps/api/.env.analysts.
# Start with bun run dev:analysts (loads that file and preserves installed extras).
# WORKBENCH_ANALYST_API_URL=http://127.0.0.1:8000
# Development only; production requires signed gateway identity headers.
# WORKBENCH_ANALYST_LOCAL_USER=local-user
